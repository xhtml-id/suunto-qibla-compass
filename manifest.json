{
  "name": "Qibla Compass",
  "version": "0.1",
  "author": "xhtml.id",
  "description": "Offline Qibla direction using GPS and compass",
  "type": "feature",
  "usage": "workout",
  "modificationTime": 1790020800,
  "image": [
    { "name": "qr.png", "type": "a64" }
  ],
  "in": [
    {
      "name": "gpsReadiness",
      "source": "/Fusion/Location/Readiness",
      "type": "subscribe"
    },
    {
      "name": "latitude",
      "source": "/Fusion/Location/GeoCoordinates.latitude",
      "type": "subscribe"
    },
    {
      "name": "longitude",
      "source": "/Fusion/Location/GeoCoordinates.longitude",
      "type": "subscribe"
    },
    {
      "name": "heading",
      "source": "/Fusion/Compass/Heading",
      "type": "subscribe"
    }
  ],
  "out": [
    { "name": "statusCode" },
    { "name": "qiblaBearing" },
    { "name": "relativeBearing" },
    { "name": "headingDegrees" },
    { "name": "turnCode" },
    { "name": "aligned" },
    { "name": "gpsReadiness" }
  ],
  "template": [
    { "name": "qibla.html" },
    { "name": "pointer.html" },
    { "name": "about.html" }
  ]
}
